# Copie para .env.local e preencha (Supabase → Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Segredos do SERVIDOR (login por PIN e seed). Nunca com prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Não troque depois de criar PINs (todos deixariam de funcionar).
PIN_SEGREDO=rL3fJcwg6ns8VLCj_OWuxO5xD8ZfFqxjeQxzzGUaf2U

# URL para onde o QR Code aponta (na Vercel: a URL pública do projeto)
NEXT_PUBLIC_APP_URL=http://localhost:3000
